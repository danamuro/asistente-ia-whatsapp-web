{
   "manifest_version": 3,
   "name": "Asistente IA para WhatsApp™ Web",
   "version": "1.2.0",
   "description": "Respuestas inteligentes con IA (Groq y Gemini Gratis), selector de tono y mejora/traducción para WhatsApp™ Web.",
   "action": {
      "default_title": "Asistente IA para WhatsApp™ Web",
      "default_popup": "options/options.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "css": [
            "content.css"
         ],
         "js": [
            "parser.js",
            "uiStuff.js",
            "contentScript.js"
         ],
         "matches": [
            "https://web.whatsapp.com/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "host_permissions": [
      "https://generativelanguage.googleapis.com/*",
      "https://api.groq.com/*",
      "https://api.github.com/*",
      "https://raw.githubusercontent.com/*"
   ],
   "icons": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
   },
   "options_page": "options/options.html",
   "permissions": [
      "storage"
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "fonts/*.woff2"
         ],
         "matches": [
            "https://web.whatsapp.com/*"
         ]
      }
   ]
}
